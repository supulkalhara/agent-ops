# ─────────────────────────────────────────────────────────────
# AgentOps — Environment Variables Sample
# Copy this file to `.env` and fill in your secrets.
# ─────────────────────────────────────────────────────────────

# ── LLM / AI Translation Layer ──────────────────────────────
LITELLM_MASTER_KEY=sk-agentops-change-me
LITELLM_LOG_LEVEL=INFO

# Provider keys (uncomment whichever you use)
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GROQ_API_KEY=gsk_xxx

# Local Ollama (no key needed if running on same network)
OLLAMA_API_BASE=http://ollama:11434

# ── Vector Database ──────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=change-me-qdrant-key
QDRANT_COLLECTION=agentops_audit

# ── API Gateway (APISIX) ────────────────────────────────────
APISIX_ADMIN_KEY=change-me-apisix-admin-key
APISIX_ADMIN_API=http://apisix:9180

# ── AgentOps Application ──────────────────────────────────
AGENTOPS_CONFIG_PATH=/etc/agentops/agentops.yaml
AGENTOPS_LOG_LEVEL=INFO
AGENTOPS_SECURITY_THRESHOLD=0.7

# ── Agent Credentials (agentops.yaml `${VAR}` references) ─────
# Each configured agent must present its token in the
# X-Agentops-Auth header. Generate with: openssl rand -hex 32
PROCUREMENT_AGENT_TOKEN=change-me-procurement-token
RESEARCH_AGENT_TOKEN=change-me-research-token
DEVOPS_AGENT_TOKEN=change-me-devops-token

# ── LLM Guard ───────────────────────────────────────────────
LLM_GUARD_API=http://llm-guard:8080
